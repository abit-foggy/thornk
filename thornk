#!/bin/sh
# thornk - Kbuild to thorn.build converter (Pith JIT)

set -e

DIR="$(cd "$(dirname "$0")" && pwd)"

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    printf 'Usage: thornk [KBUILD_FILE] [OUTPUT_SPEC]\n\n'
    printf 'Converts a Linux Kbuild/Makefile into a thorn.build specification.\n\n'
    printf 'Arguments:\n'
    printf '  KBUILD_FILE    Path to Kbuild or Makefile (default: Kbuild, Makefile, or fixtures/Kbuild.sample)\n'
    printf '  OUTPUT_SPEC    Output specification path (default: thorn.build)\n\n'
    printf 'Environment:\n'
    printf '  PROJECT        Project name override (default: linux_subsystem)\n'
    printf '  KBUILD         Alternative way to pass KBUILD_FILE\n'
    printf '  OUTPUT         Alternative way to pass OUTPUT_SPEC\n'
    exit 0
fi

if [ -n "$1" ]; then
    export KBUILD="$1"
fi

if [ -n "$2" ]; then
    export OUTPUT="$2"
fi

exec pith run "$DIR/thornk.pi"
