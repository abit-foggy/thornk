# walker.pi - Recursive Kbuild subdirectory traversal for thornk
import "vendor/thorn/src/decompile.c"
import "thornk.c"

fn walk_directory(root_dir, current_scope)
    visited = thornk.is_dir_visited(current_scope)
    if visited == 1
        return 0
    end
    thornk.mark_dir_visited(current_scope)

    makefile_path = thornk.find_kbuild_file(root_dir, current_scope)
    if str.length(makefile_path) == 0
        return 0
    end

    # Ingest composite objects (-objs / -y) first so composites are registered
    resolve_composite_objects(makefile_path, current_scope, root_dir)

    # Ingest direct objects (built-in.a), expanding any composite members
    resolve_direct_objects(makefile_path, current_scope, root_dir)

    # Scan and traverse subdirectories
    nsub = thornk.scan_kbuild_subdirs(makefile_path, current_scope)
    mut s = 0
    while s < nsub
        sub_dir = thornk.get_scanned_subdir(s)
        sub_visited = thornk.is_dir_visited(sub_dir)
        if sub_visited == 0
            thornk.push_subdir_level()
            walk_directory(root_dir, sub_dir)
            thornk.pop_subdir_level()
        end
        mut s = s + 1
    end

    return 1
end

fn walk_kbuild_tree(root_dir, kmap)
    walk_directory(root_dir, "")
    walk_directory(root_dir, "lib")
    walk_directory(root_dir, "arch/x86/lib")
    walk_directory(root_dir, "arch/x86/pci")
    walk_directory(root_dir, "arch/x86/power")
    walk_directory(root_dir, "arch/x86/video")
    return 1
end
