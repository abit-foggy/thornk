# main.pi - CLI driver and compiler setup for thornk
import "/home/foggy/thorn/src/decompile.c"
import "/home/foggy/thornk/src/thornk.c"

# Ingest CLI arguments
argc = proc.argCount()
if argc < 2
    print "Usage: thornk <kernel_source_dir> [--config <path>] [--arch <arch>] [--out <file>]"
    proc.exit(1)
end

mut a_idx = 1
while a_idx < argc
    arg = proc.getArg(a_idx)
    thornk.add_cli_arg(arg)
    a_idx = a_idx + 1
end

thornk.process_cli_args()

kernel_dir = thornk.get_kernel_dir()
config_path = thornk.get_config_path()
arch = thornk.get_arch()
out_file = thornk.get_out_file()

print "thornk: configuring Linux kernel build"
print "kernel root: " + kernel_dir
print "arch: " + arch
print "config: " + config_path
print "output: " + out_file

# Step 1: Initialize Thorn and load .config
thornk.kconfig_reset()
cfg_count = thornk.parse_kconfig_file(config_path)
thornk.print_stat("loaded config entries: ", cfg_count)

mut proj_name = os.getEnv("PROJECT")
if str.length(proj_name) == 0
    proj_name = "linux_subsystem"
end

decompile.reset()
decompile.set_project(proj_name)
decompile.set_compiler("gcc")
decompile.set_ar("ar")

# Step 2: Configure filters and freestanding kernel flags
decompile.ignore_target("test_*")
decompile.ignore_target("*_test")
decompile.ignore_target("kunit_*")
decompile.ignore_target("selftest_*")

decompile.strip_cflag("-fconserve-stack")
decompile.strip_cflag("-mrecord-mcount")
decompile.strip_cflag("-fno-var-tracking-assignments")

decompile.inject_cflag("*", "-nostdinc")
decompile.inject_cflag("*", "-D__KERNEL__")
decompile.inject_cflag("*", "-ffreestanding")
decompile.inject_cflag("*", "-fno-strict-aliasing")
decompile.inject_cflag("*", "-mno-red-zone")
decompile.inject_cflag("*", "-O2")
decompile.inject_cflag("*", "-std=gnu11")
decompile.inject_cflag("*", "-fshort-wchar")

# Forced includes for freestanding kernel builds
if fs.exists(kernel_dir + "/include/linux/compiler-version.h") == 1
    decompile.inject_cflag("*", "-include" + kernel_dir + "/include/linux/compiler-version.h")
end
if fs.exists(kernel_dir + "/include/linux/kconfig.h") == 1
    decompile.inject_cflag("*", "-include" + kernel_dir + "/include/linux/kconfig.h")
end
if fs.exists(kernel_dir + "/include/linux/compiler_types.h") == 1
    decompile.inject_cflag("*", "-include" + kernel_dir + "/include/linux/compiler_types.h")
end
if fs.exists(kernel_dir + "/init/utsversion-tmp.h") == 1
    decompile.inject_cflag("*", "-include" + kernel_dir + "/init/utsversion-tmp.h")
end


# Global INCLUDES
decompile.inject_include("*", "include")
decompile.inject_include("*", "include/uapi")
decompile.inject_include("*", kernel_dir + "/include")
decompile.inject_include("*", kernel_dir + "/include/uapi")
decompile.inject_include("*", kernel_dir + "/arch/" + arch + "/include")
decompile.inject_include("*", kernel_dir + "/arch/" + arch + "/include/uapi")
decompile.inject_include("*", kernel_dir + "/arch/" + arch + "/include/generated")
decompile.inject_include("*", kernel_dir + "/arch/" + arch + "/include/generated/uapi")
decompile.inject_include("*", kernel_dir + "/include/generated/uapi")

# Step 3: Run recursive walker from kernel root (or single file if given file)
if fs.exists(kernel_dir + "/Makefile") == 1
    walk_kbuild_tree(kernel_dir, 0)
else
    if fs.exists(kernel_dir + "/Kbuild") == 1
        walk_kbuild_tree(kernel_dir, 0)
    else
        # Single file conversion mode
        resolve_direct_objects(kernel_dir, "", ".")
        resolve_composite_objects(kernel_dir, "", ".")
    end
end

# Step 4: Emit output (Ninja or Thorn spec)
is_spec = thornk.is_spec_output()
if is_spec == 1
    spec = decompile.to_thorn()
    fs.writeFile(out_file, spec)
else
    decompile.emit_ninja_file(out_file)
    thornk.postprocess_vmlinux(out_file, kernel_dir, arch)
end

# Step 5: Print generation stats
total_targets = decompile.target_count()
print "thornk: successfully generated " + out_file
thornk.print_stat("total targets: ", total_targets)

