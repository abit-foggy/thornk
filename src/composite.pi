# composite.pi - Composite object and module dependency tracking for thornk
import "/home/foggy/thorn/src/decompile.c"
import "/home/foggy/thornk/src/thornk.c"

fn resolve_composite_objects(makefile_path, scope, root_dir)
    n = thornk.scan_composite_objects(makefile_path, scope)
    mut c_idx = 0
    while c_idx < n
        target_name = thornk.get_composite_target(c_idx)
        t_scope = thornk.get_composite_scope(c_idx)
        is_mod = thornk.get_composite_is_module(c_idx)
        nm = thornk.get_composite_member_count(c_idx)

        qualified_tgt = thornk.qualify_target(t_scope, target_name)
        decompile.set_target_type(qualified_tgt, 2)

        mut m_idx = 0
        while m_idx < nm
            mem_o = thornk.get_composite_member(c_idx, m_idx)
            src_file = thornk.resolve_source_path(root_dir, t_scope, mem_o)
            if str.length(src_file) > 0
                decompile.add_target_source(qualified_tgt, src_file)
            end
            m_idx = m_idx + 1
        end


        c_idx = c_idx + 1
    end
    return n
end

fn resolve_direct_objects(makefile_path, scope, root_dir)
    nd = thornk.scan_direct_objects(makefile_path, scope)
    if nd > 0
        tgt = thornk.qualify_target(scope, "built-in.a")
        decompile.set_target_type(tgt, 2)
        mut d_idx = 0
        while d_idx < nd
            mem_o = thornk.get_direct_member(d_idx)
            src_file = thornk.resolve_source_path(root_dir, scope, mem_o)
            if str.length(src_file) > 0
                decompile.add_target_source(tgt, src_file)
            end
            d_idx = d_idx + 1
        end
    end
    return nd
end
