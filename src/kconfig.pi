# kconfig.pi - .config reader and variable evaluator for thornk
import "thornk.c"

fn parse_kconfig(path)
    count = thornk.parse_kconfig_file(path)
    return count
end

fn get_kconfig_var(key)
    val = thornk.is_config_set(key)
    return val
end

fn eval_kconfig_expr(kmap, expr)
    enabled = thornk.is_expr_enabled(expr)
    return enabled
end
