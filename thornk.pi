# thornk.pi - Converts Linux Kbuild Makefiles to thorn.build specs (Pith JIT)

import "/home/foggy/thorn/src/decompile.c"

print "=== thornk: Kbuild -> thorn.build converter ==="

# Determine input Kbuild path
mut kbuild_path = os.getEnv("KBUILD")
if str.length(kbuild_path) == 0
    if fs.exists("Kbuild")
        kbuild_path = "Kbuild"
    else
        if fs.exists("Makefile")
            kbuild_path = "Makefile"
        else
            kbuild_path = "fixtures/Kbuild.sample"
        end
    end
end

# Determine output spec path
mut out_path = os.getEnv("OUTPUT")
if str.length(out_path) == 0
    out_path = "thorn.build"
end

# Determine project name
mut proj_name = os.getEnv("PROJECT")
if str.length(proj_name) == 0
    proj_name = "linux_subsystem"
end

print "Input Kbuild:  " + kbuild_path
print "Output Spec:   " + out_path
print "Project Name:  " + proj_name

# Configure conversion hooks
decompile.reset()
decompile.set_project(proj_name)
decompile.set_compiler("gcc")
decompile.set_ar("ar")

# Hook 1: Filter out kernel test targets and test harnesses
decompile.ignore_target("test_*")
decompile.ignore_target("*_test")
decompile.ignore_target("kunit_*")
decompile.ignore_target("selftest_*")

# Hook 2: Strip GCC-specific flags that break portable compilation
decompile.strip_cflag("-fconserve-stack")
decompile.strip_cflag("-mrecord-mcount")
decompile.strip_cflag("-fno-var-tracking-assignments")

# Hook 3: Inject required kernel compilation flags and headers
decompile.inject_cflag("*", "-D__KERNEL__")
decompile.inject_cflag("*", "-O2")
decompile.inject_include("*", "include")
decompile.inject_include("*", "include/uapi")

# Parse input Kbuild file
ok = decompile.parse_file(kbuild_path)
if ok != 1
    print "error: failed to parse " + kbuild_path
    os.exit(1)
end

# Inspect targets
ntgts = decompile.target_count()
print "Discovered targets: "
print ntgts

mut i = 0
while i < ntgts
    name = decompile.get_target_name(i)
    srcs = decompile.get_target_sources(i)
    cfl = decompile.get_target_cflags(i)
    print "  [" + name + "]"
    print "    sources: " + srcs
    print "    flags:   " + cfl
    i = i + 1
end

# Generate thorn.build specification
spec = decompile.to_thorn()

# Write to output file
fs.writeFile(out_path, spec)
print "Generated: " + out_path

print "=== Specification Preview ==="
print spec
